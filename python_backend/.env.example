DEBUG=True
PORT=5000

# Convex Integration
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_API_KEY=your-api-key-here

# Model Configuration
MODEL_NAME=microsoft/DialoGPT-medium
MAX_LENGTH=512
TEMPERATURE=0.7

# Training Configuration
BATCH_SIZE=2
LEARNING_RATE=5e-5
NUM_EPOCHS=3
WARMUP_STEPS=100

# Weights & Biases (optional)
WANDB_PROJECT=medibot-training
WANDB_API_KEY=your-wandb-key

# Storage
MODEL_SAVE_PATH=./medibot_model
DATA_SAVE_PATH=./training_data
